{
  "name": "sisprestamos/webapp",
  "description": "Sistema web de gestion de prestamos con PHP, Bootstrap y MySQL.",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "dompdf/dompdf": "3.1.6",
    "minishlink/web-push": "^11.0",
    "php-http/guzzle7-adapter": "^1.1",
    "phpmailer/phpmailer": "^6.9",
    "phpoffice/phpspreadsheet": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
